#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(std430,binding=0) readonly buffer Previous{uint previousPixels[];};
layout(std430,binding=1) readonly buffer Current{uint currentPixels[];};
layout(std430,binding=2) writeonly buffer Output{uint outputPixels[];};
layout(push_constant) uniform Params{int width;int height;} params;
int luminance(uint p){return (77*int((p>>16)&255u)+150*int((p>>8)&255u)+29*int(p&255u))>>8;}
ivec2 bound(ivec2 p){return clamp(p,ivec2(0),ivec2(params.width-1,params.height-1));}
uint sampleFrame(ivec2 p,bool fromCurrent){int i=bound(p).y*params.width+bound(p).x;return fromCurrent?currentPixels[i]:previousPixels[i];}
ivec2 estimate(ivec2 p,bool reverse){
 int best=0x7fffffff;int bestDistance=0;ivec2 offset=ivec2(0);
 for(int y=-2;y<=2;y++)for(int x=-2;x<=2;x++){
  int a=luminance(sampleFrame(p,reverse));int b=luminance(sampleFrame(p+ivec2(x,y),!reverse));
  int cost=abs(a-b);int distance=x*x+y*y;
  if(cost<best||(cost==best&&distance<bestDistance)){best=cost;bestDistance=distance;offset=ivec2(x,y);}
 }
 return offset;
}
uint midpoint(uint a,uint b){
 uint r=(((a>>16)&255u)+((b>>16)&255u))/2u;
 uint g=(((a>>8)&255u)+((b>>8)&255u))/2u;
 uint bl=((a&255u)+(b&255u))/2u;
 return 0xff000000u|(r<<16)|(g<<8)|bl;
}
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(p.x>=params.width||p.y>=params.height)return;
 ivec2 forward=estimate(p,false);ivec2 q=bound(p+forward);ivec2 backward=estimate(q,true);
 bool consistent=all(lessThanEqual(abs(forward+backward),ivec2(1)));
 ivec2 pa=bound(p-ivec2(round(vec2(forward)*0.5)));
 ivec2 pb=bound(p+ivec2(round(vec2(forward)*0.5)));
 uint plain=midpoint(sampleFrame(p,false),sampleFrame(p,true));
 uint warped=midpoint(sampleFrame(pa,false),sampleFrame(pb,true));
 outputPixels[p.y*params.width+p.x]=consistent?warped:plain;
}
